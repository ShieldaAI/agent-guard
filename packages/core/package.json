{
  "name": "@shieldaai/agent-guard",
  "version": "1.1.0",
  "description": "Limit what a misled AI agent can do: every tool call is checked against its task's grants, approvals and budget before it runs.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldaAI/agent-guard.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ShieldaAI/agent-guard#readme",
  "bugs": {
    "url": "https://github.com/ShieldaAI/agent-guard/issues"
  },
  "keywords": [
    "agent-guard",
    "ai-agents",
    "security",
    "authorization",
    "typescript",
    "nodejs",
    "tool-authorization",
    "access-control",
    "human-in-the-loop",
    "budgets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/release-check.mjs"
  }
}
