{
  "name": "@shieldaai/agent-map",
  "version": "1.1.1",
  "description": "Read-only AI agent and MCP inventory queries over HTTP and MCP, with scoped access to Cartography projections.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./oidc": {
      "types": "./dist/oidc.d.ts",
      "import": "./dist/oidc.js"
    },
    "./identity-http": {
      "types": "./dist/identity-http.d.ts",
      "import": "./dist/identity-http.js"
    }
  },
  "bin": {
    "agent-guard-map": "./dist/cli.js",
    "agent-guard-map-identity": "./dist/identity-cli.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@shieldaai/agent-guard": "1.1.1",
    "neo4j-driver": "6.3.0",
    "openid-client": "6.8.8"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldaAI/agent-guard.git",
    "directory": "packages/agent-map"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/release-check.mjs"
  },
  "homepage": "https://github.com/ShieldaAI/agent-guard/tree/main/packages/agent-map#readme",
  "bugs": {
    "url": "https://github.com/ShieldaAI/agent-guard/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-inventory",
    "mcp",
    "model-context-protocol",
    "cartography",
    "neo4j",
    "typescript",
    "access-explanations"
  ]
}
