{
  "name": "@shieldaai/agent-guard-mcp",
  "version": "1.1.0",
  "description": "Authorize MCP tool calls in TypeScript with approved metadata, task-scoped resources and Agent Guard.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldaAI/agent-guard.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/ShieldaAI/agent-guard/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/ShieldaAI/agent-guard/issues"
  },
  "keywords": [
    "agent-guard",
    "ai-agents",
    "security",
    "authorization",
    "mcp",
    "model-context-protocol",
    "typescript",
    "tool-authorization",
    "tool-approval",
    "metadata-drift",
    "agent-security"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/release-check.mjs"
  },
  "dependencies": {
    "jose": "6.2.17",
    "@shieldaai/agent-guard": "1.1.0",
    "@modelcontextprotocol/client": "2.4.0"
  }
}
