{
  "name": "@shieldaai/agent-guard-scenarios",
  "version": "1.0.0",
  "description": "Executable malicious and benign conformance fixtures for AI agent tool authorization, approvals and budgets.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldaAI/agent-guard.git",
    "directory": "packages/scenarios"
  },
  "homepage": "https://github.com/ShieldaAI/agent-guard/tree/main/packages/scenarios#readme",
  "bugs": {
    "url": "https://github.com/ShieldaAI/agent-guard/issues"
  },
  "keywords": [
    "agent-guard",
    "ai-agents",
    "security",
    "authorization",
    "security-testing",
    "conformance-testing",
    "tool-authorization",
    "approvals",
    "budgets",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/release-check.mjs"
  },
  "dependencies": {
    "@shieldaai/agent-guard": "1.0.0"
  }
}
