{
  "name": "@shieldaai/agent-guard-executor",
  "version": "0.1.0",
  "description": "Durable AI agent tool authorization with SQLite state, authenticated task APIs, approvals and budget admission.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agent-guard-pilot-review": "./dist/pilot-review-cli.js",
    "agent-guard-ledger": "./dist/ledger-maintenance-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@shieldaai/agent-guard": "0.1.0",
    "ipaddr.js": "2.5.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldaAI/agent-guard.git",
    "directory": "packages/executor"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/build.mjs",
    "prepublishOnly": "node ../../scripts/release-check.mjs"
  },
  "homepage": "https://github.com/ShieldaAI/agent-guard/tree/main/packages/executor#readme",
  "bugs": {
    "url": "https://github.com/ShieldaAI/agent-guard/issues"
  },
  "keywords": [
    "ai-agents",
    "typescript",
    "nodejs",
    "tool-authorization",
    "sqlite",
    "approvals",
    "budgets",
    "durable-execution"
  ]
}
