{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shielda.ai/schemas/agent-guard-inventory-manifest-v1.schema.json",
  "title": "Agent Guard host-owned inventory manifest version 1",
  "description": "Closed, single-source host assertions. Schema validation is followed by duplicate, cross-reference and canonical AWS identifier checks; no field grants executor or backend permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "source",
    "manifestId",
    "revision",
    "observedAt",
    "agents",
    "deployments",
    "taskBindings",
    "resourceBindings",
    "executionBindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceKind": {
      "const": "host_asserted"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "manifestId": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "$ref": "#/$defs/safeInteger"
    },
    "observedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "agents": {
      "type": "array",
      "maxItems": 1000,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/manifestAgent"
      }
    },
    "deployments": {
      "type": "array",
      "maxItems": 1000,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/manifestDeployment"
      }
    },
    "taskBindings": {
      "type": "array",
      "maxItems": 10000,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/manifestTaskBinding"
      }
    },
    "resourceBindings": {
      "type": "array",
      "maxItems": 10000,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/manifestResourceBinding"
      }
    },
    "executionBindings": {
      "type": "array",
      "maxItems": 10000,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/manifestExecutionBinding"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![\\s\\u001c-\\u001f\\u0085\\uFEFF]*$)[^\\u0000]*$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])",
      "description": "UTC RFC3339 timestamp with optional fractional seconds up to microsecond precision."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companyId",
        "sourceId",
        "enrollmentGeneration",
        "inventoryInstanceId",
        "tenantId"
      ],
      "properties": {
        "companyId": {
          "$ref": "#/$defs/identifier"
        },
        "sourceId": {
          "$ref": "#/$defs/identifier"
        },
        "enrollmentGeneration": {
          "$ref": "#/$defs/identifier"
        },
        "inventoryInstanceId": {
          "$ref": "#/$defs/identifier"
        },
        "tenantId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "awsReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "partition",
        "accountId",
        "region",
        "arn"
      ],
      "properties": {
        "provider": {
          "const": "aws"
        },
        "partition": {
          "enum": [
            "aws",
            "aws-cn",
            "aws-us-gov"
          ]
        },
        "accountId": {
          "type": "string",
          "pattern": "^[0-9]{12}$(?![\\s\\S])"
        },
        "region": {
          "const": ""
        },
        "arn": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?!.*[\\s\\u001c-\\u001f\\u0085\\uFEFF*?\\u0000])arn:(aws|aws-cn|aws-us-gov):[a-z0-9][a-z0-9-]*:[^:]*:[^:]*:.+$"
        }
      },
      "description": "Version-1 execution identity subset: global IAM user/role or STS assumed-role ARN. This is a host assertion, not evidence of identity existence or permission.",
      "anyOf": [
        {
          "properties": {
            "arn": {
              "pattern": "^arn:(aws|aws-cn|aws-us-gov):iam::[0-9]{12}:(role|user)/(?:[^/]+/)*[^/]+$"
            }
          }
        },
        {
          "properties": {
            "arn": {
              "pattern": "^arn:(aws|aws-cn|aws-us-gov):sts::[0-9]{12}:assumed-role/[^/]+/[^/]+$"
            }
          }
        }
      ]
    },
    "awsResourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "partition",
        "accountId",
        "region",
        "arn",
        "kind"
      ],
      "properties": {
        "provider": {
          "const": "aws"
        },
        "partition": {
          "enum": [
            "aws",
            "aws-cn",
            "aws-us-gov"
          ]
        },
        "accountId": {
          "type": "string",
          "pattern": "^[0-9]{12}$(?![\\s\\S])"
        },
        "region": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[a-z0-9-]*$(?![\\s\\S])"
        },
        "arn": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?!.*[\\s\\u001c-\\u001f\\u0085\\uFEFF*?\\u0000])arn:(aws|aws-cn|aws-us-gov):[a-z0-9][a-z0-9-]*:[^:]*:[^:]*:.+$"
        },
        "kind": {
          "enum": [
            "bucket",
            "object",
            "prefix",
            "resource"
          ]
        }
      }
    },
    "manifestAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "ownerId",
        "teamId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "ownerId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "teamId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "manifestDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agentId",
        "environment"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "agentId": {
          "$ref": "#/$defs/identifier"
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "manifestTaskBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "deploymentId"
      ],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/identifier"
        },
        "deploymentId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "awsAction": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[a-z0-9][a-z0-9-]*:[A-Za-z][A-Za-z0-9]*$(?![\\s\\S])"
    },
    "manifestResourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "resourceRef",
        "target",
        "actions",
        "scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "tool": {
          "$ref": "#/$defs/identifier"
        },
        "resourceRef": {
          "allOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "not": {
                "const": "*"
              }
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/awsResourceReference"
        },
        "actions": {
          "type": "array",
          "maxItems": 128,
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/awsAction"
          },
          "uniqueItems": true
        },
        "scope": {
          "enum": [
            "exact",
            "prefix"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "prefix"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "const": "prefix"
              }
            }
          },
          "else": {
            "properties": {
              "scope": {
                "const": "exact"
              }
            }
          }
        }
      ]
    },
    "manifestExecutionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "deploymentId",
        "connectionId",
        "identitySelection",
        "identity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "tool": {
          "$ref": "#/$defs/identifier"
        },
        "deploymentId": {
          "$ref": "#/$defs/identifier"
        },
        "connectionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "identitySelection": {
          "enum": [
            "static",
            "dynamic",
            "unknown"
          ]
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/awsReference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identitySelection": {
                "const": "static"
              }
            }
          },
          "then": {
            "properties": {
              "identity": {
                "$ref": "#/$defs/awsReference"
              }
            }
          },
          "else": {
            "properties": {
              "identity": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
