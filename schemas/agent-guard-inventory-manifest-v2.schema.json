{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shielda.ai/schemas/agent-guard-inventory-manifest-v2.schema.json",
  "title": "Agent Guard host-owned inventory manifest version 2",
  "description": "Closed, source-scoped company assertions for agents, ownership, resource and credential references. Semantic reference validation follows schema validation. These observations do not grant permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "source",
    "manifestId",
    "revision",
    "observedAt",
    "agents",
    "deployments",
    "taskBindings",
    "resourceBindings",
    "executionBindings",
    "authorityId",
    "owners",
    "credentialReferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "evidenceKind": {
      "const": "host_asserted"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "manifestId": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "$ref": "#/$defs/safeInteger"
    },
    "observedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "agents": {
      "type": "array",
      "maxItems": 1000,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/manifestAgent"
      }
    },
    "deployments": {
      "type": "array",
      "maxItems": 1000,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/manifestDeployment"
      }
    },
    "taskBindings": {
      "type": "array",
      "maxItems": 10000,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/manifestTaskBinding"
      }
    },
    "resourceBindings": {
      "type": "array",
      "maxItems": 10000,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/manifestResourceBinding"
      }
    },
    "executionBindings": {
      "type": "array",
      "maxItems": 10000,
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/manifestExecutionBinding"
      }
    },
    "authorityId": {
      "$ref": "#/$defs/identifier"
    },
    "owners": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/owner"
      }
    },
    "credentialReferences": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/credentialReference"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![\\s\\u001c-\\u001f\\u0085\\uFEFF]*$)[^\\u0000]*$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$(?![\\s\\S])",
      "description": "UTC RFC3339 timestamp with optional fractional seconds up to microsecond precision."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companyId",
        "sourceId",
        "enrollmentGeneration",
        "inventoryInstanceId",
        "tenantId"
      ],
      "properties": {
        "companyId": {
          "$ref": "#/$defs/identifier"
        },
        "sourceId": {
          "$ref": "#/$defs/identifier"
        },
        "enrollmentGeneration": {
          "$ref": "#/$defs/identifier"
        },
        "inventoryInstanceId": {
          "$ref": "#/$defs/identifier"
        },
        "tenantId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "awsReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "partition",
        "accountId",
        "region",
        "arn"
      ],
      "properties": {
        "provider": {
          "const": "aws"
        },
        "partition": {
          "enum": [
            "aws",
            "aws-cn",
            "aws-us-gov"
          ]
        },
        "accountId": {
          "type": "string",
          "pattern": "^[0-9]{12}$(?![\\s\\S])"
        },
        "region": {
          "const": ""
        },
        "arn": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?!.*[\\s\\u001c-\\u001f\\u0085\\uFEFF*?\\u0000])arn:(aws|aws-cn|aws-us-gov):[a-z0-9][a-z0-9-]*:[^:]*:[^:]*:.+$"
        }
      },
      "description": "Version-1 execution identity subset: global IAM user/role or STS assumed-role ARN. This is a host assertion, not evidence of identity existence or permission.",
      "anyOf": [
        {
          "properties": {
            "arn": {
              "pattern": "^arn:(aws|aws-cn|aws-us-gov):iam::[0-9]{12}:(role|user)/(?:[^/]+/)*[^/]+$"
            }
          }
        },
        {
          "properties": {
            "arn": {
              "pattern": "^arn:(aws|aws-cn|aws-us-gov):sts::[0-9]{12}:assumed-role/[^/]+/[^/]+$"
            }
          }
        }
      ]
    },
    "awsResourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "partition",
        "accountId",
        "region",
        "arn",
        "kind"
      ],
      "properties": {
        "provider": {
          "const": "aws"
        },
        "partition": {
          "enum": [
            "aws",
            "aws-cn",
            "aws-us-gov"
          ]
        },
        "accountId": {
          "type": "string",
          "pattern": "^[0-9]{12}$(?![\\s\\S])"
        },
        "region": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[a-z0-9-]*$(?![\\s\\S])"
        },
        "arn": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?!.*[\\s\\u001c-\\u001f\\u0085\\uFEFF*?\\u0000])arn:(aws|aws-cn|aws-us-gov):[a-z0-9][a-z0-9-]*:[^:]*:[^:]*:.+$"
        },
        "kind": {
          "enum": [
            "bucket",
            "object",
            "prefix",
            "resource"
          ]
        }
      }
    },
    "manifestAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "ownerId",
        "teamId",
        "purpose",
        "lifecycleState",
        "ownershipStatus",
        "ownershipSource"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "ownerId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "teamId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "anyOf": [
            {
              "$ref": "#/$defs/purpose"
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycleState": {
          "enum": [
            "active",
            "inactive",
            "retired",
            "unknown"
          ]
        },
        "ownershipStatus": {
          "$ref": "#/$defs/ownershipStatus"
        },
        "ownershipSource": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ownershipStatus": {
                "const": "assigned"
              }
            }
          },
          "then": {
            "properties": {
              "ownerId": {
                "$ref": "#/$defs/identifier"
              }
            }
          },
          "else": {
            "properties": {
              "ownerId": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "manifestDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agentId",
        "environment",
        "runtimeRef",
        "workloadGeneration",
        "buildRef",
        "bindingAuthority",
        "credentialReferenceIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "agentId": {
          "$ref": "#/$defs/identifier"
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtimeRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        },
        "workloadGeneration": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "buildRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        },
        "bindingAuthority": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "credentialReferenceIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaque"
          }
        }
      }
    },
    "manifestTaskBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "deploymentId"
      ],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/identifier"
        },
        "deploymentId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "awsAction": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[a-z0-9][a-z0-9-]*:[A-Za-z][A-Za-z0-9]*$(?![\\s\\S])"
    },
    "manifestResourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "resourceRef",
        "target",
        "actions",
        "scope",
        "displayName",
        "ownerId",
        "ownershipStatus",
        "ownershipSource",
        "sensitivity",
        "approvedDestinations",
        "dependsOn"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "tool": {
          "$ref": "#/$defs/identifier"
        },
        "resourceRef": {
          "allOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "not": {
                "const": "*"
              }
            }
          ]
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/awsResourceReference"
            },
            {
              "$ref": "#/$defs/hostResourceReference"
            }
          ]
        },
        "actions": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1
        },
        "scope": {
          "enum": [
            "exact",
            "prefix"
          ]
        },
        "displayName": {
          "$ref": "#/$defs/displayName"
        },
        "ownerId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownershipStatus": {
          "$ref": "#/$defs/ownershipStatus"
        },
        "ownershipSource": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "unknown"
          ]
        },
        "approvedDestinations": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaque"
          }
        },
        "dependsOn": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "provider": {
                    "const": "aws"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "actions": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/awsAction"
                },
                "minItems": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "target": {
                      "properties": {
                        "kind": {
                          "const": "prefix"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "scope": {
                      "const": "prefix"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "scope": {
                      "const": "exact"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ownershipStatus": {
                "const": "assigned"
              }
            }
          },
          "then": {
            "properties": {
              "ownerId": {
                "$ref": "#/$defs/identifier"
              }
            }
          },
          "else": {
            "properties": {
              "ownerId": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "manifestExecutionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "deploymentId",
        "connectionId",
        "identitySelection",
        "identity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "tool": {
          "$ref": "#/$defs/identifier"
        },
        "deploymentId": {
          "$ref": "#/$defs/identifier"
        },
        "connectionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "identitySelection": {
          "enum": [
            "static",
            "dynamic",
            "unknown"
          ]
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/awsReference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identitySelection": {
                "const": "static"
              }
            }
          },
          "then": {
            "properties": {
              "identity": {
                "$ref": "#/$defs/awsReference"
              }
            }
          },
          "else": {
            "properties": {
              "identity": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?![\\s\\u001c-\\u001f\\u0085\\uFEFF]*$)[^\\u0000]*$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![\\s\\u001c-\\u001f\\u0085\\uFEFF]*$)[^\\u0000]*$"
    },
    "opaque": {
      "type": "string",
      "pattern": "^opaque:[a-f0-9]{64}$(?![\\s\\S])",
      "maxLength": 71
    },
    "ownershipStatus": {
      "enum": [
        "assigned",
        "unassigned",
        "unknown"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "kind": {
          "enum": [
            "person",
            "team",
            "service"
          ]
        }
      }
    },
    "credentialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "issuerRef",
        "audienceRefs",
        "recipientRefs",
        "lifecycleState",
        "expiresAt",
        "rotationStatus"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/opaque"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "issuerRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/opaque"
            },
            {
              "type": "null"
            }
          ]
        },
        "audienceRefs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaque"
          }
        },
        "recipientRefs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaque"
          }
        },
        "lifecycleState": {
          "enum": [
            "active",
            "rotating",
            "revoked",
            "expired",
            "unknown"
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "rotationStatus": {
          "enum": [
            "current",
            "due",
            "overdue",
            "unknown"
          ]
        }
      }
    },
    "hostResourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "provider": {
          "const": "host"
        },
        "id": {
          "$ref": "#/$defs/opaque"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "kind": {
          "enum": [
            "service",
            "repository",
            "database",
            "queue",
            "storage",
            "other"
          ]
        }
      }
    }
  }
}
