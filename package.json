{
  "name": "shielda-agent-guard-workspace",
  "private": true,
  "version": "0.1.0-alpha.2",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "packages/scenarios",
    "packages/executor",
    "packages/agent-map",
    "apps/agent-map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test packages/core/test/*.test.mjs packages/mcp/test/*.test.mjs packages/scenarios/test/*.test.mjs packages/executor/test/*.test.mjs packages/agent-map/test/*.test.mjs apps/agent-map/test/*.test.mjs scripts/*.test.mjs",
    "test:pack": "node scripts/check-packages.mjs",
    "check": "npm test && npm run test:pack",
    "demo": "npm run build && node examples/basic.mjs",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
