{
  "name": "shielda-agent-guard-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "packages/scenarios",
    "packages/executor",
    "packages/agent-map",
    "apps/agent-map"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node scripts/test-workspace.mjs packages/core/test/*.test.mjs packages/mcp/test/*.test.mjs packages/scenarios/test/*.test.mjs packages/executor/test/*.test.mjs packages/agent-map/test/*.test.mjs apps/agent-map/test/*.test.mjs apps/agent-ops/test/*.test.mjs scripts/*.test.mjs",
    "test:pack": "node scripts/check-packages.mjs",
    "check": "npm test && npm run test:pack",
    "evaluate:provider-trials": "npm run build && node scripts/evaluate-provider-trials.mjs",
    "evaluate:providers": "npm run build && node scripts/evaluate-provider-tools.mjs",
    "demo": "npm run build && node examples/basic.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "verify:mcp-isolation": "npm run build && node scripts/verify-mcp-isolation.mjs",
    "format": "prettier --write \"packages/**/*.{ts,mts,mjs,js}\" \"apps/**/*.{ts,mts,mjs,js}\" \"scripts/**/*.{ts,mts,mjs,js}\" \"examples/**/*.{ts,mts,mjs,js}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,mts,mjs,js}\" \"apps/**/*.{ts,mts,mjs,js}\" \"scripts/**/*.{ts,mts,mjs,js}\" \"examples/**/*.{ts,mts,mjs,js}\""
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
